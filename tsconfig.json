{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["dom", "es2022"],
    "types": ["node"]
  },
  "include": ["packages/*/src", "check.ts", "check-regressions.ts"]
}
